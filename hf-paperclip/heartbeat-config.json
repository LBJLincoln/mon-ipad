{
  "heartbeat_engine": {
    "enabled": true,
    "default_interval": "4h",
    "stuck_detection_timeout": "2h",
    "max_retries": 3
  },
  "schedules": {
    "halftime-scorer": {
      "interval": "2min",
      "active_hours": "23:00-05:00 UTC",
      "active_days": "game_days_only"
    },
    "odds-monitor": {
      "interval": "30min",
      "active_days": "game_days_only"
    },
    "infra-agent": {
      "interval": "30min"
    },
    "evolution-monitor": {
      "interval": "2h"
    },
    "test-runner": {
      "interval": "4h"
    },
    "orchestrator": {
      "interval": "4h"
    },
    "paper-scout": {
      "interval": "6h"
    },
    "dashboard-sync": {
      "interval": "1h"
    },
    "repo-scout": {
      "interval": "12h"
    },
    "data-scout": {
      "interval": "24h"
    },
    "results-evaluator": {
      "interval": "daily",
      "time": "10:00 UTC"
    },
    "betting-strategist": {
      "interval": "daily",
      "time": "21:00 UTC"
    },
    "performance-analyst": {
      "interval": "weekly",
      "day": "sunday"
    },
    "code-optimizer": {
      "interval": "weekly",
      "day": "saturday"
    }
  },
  "notifications": {
    "telegram_channel": "@Nomos42",
    "telegram_bot": "@Nomos42Bot",
    "alert_on": ["agent_stuck", "budget_exceeded", "brier_improvement", "critical_error"]
  }
}
