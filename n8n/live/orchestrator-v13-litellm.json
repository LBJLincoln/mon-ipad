    {
      "parameters": {
        "jsCode": "// Classify intent and call appropriate pipeline\nconst body = $input.first().json.body || $input.first().json;\nconst query = body.query || '';\nconst tenant_id = body.tenant_id || 'benchmark';\n\n// Simple intent classification (no LLM needed for basic routing)\nconst q = query.toLowerCase();\nlet intent = 'standard';\n\n// Quantitative: numbers, financial data, SQL-type\nif (/chiffre d.affaires|revenue|bilan|profit|perte|total|montant|combien|\\d+\\s*(euros|%|millions)/.test(q)) {\n  intent = 'quantitative';\n}\n// Graph: relationships, connections\nelse if (/relation|lien|connect|entre.*et|qui.*avec|réseau|graphe/.test(q)) {\n  intent = 'graph';\n}\n\nreturn [{ json: { query, tenant_id, intent, top_k: 10, include_sources: true } }];"
      },
      "id": "orch-classify",
      "name": "Classify Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
