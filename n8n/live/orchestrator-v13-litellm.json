    {
      "parameters": {
        "jsCode": "// Format response from any pipeline\nconst raw = $input.first().json;\nlet data = raw;\nif (Array.isArray(data)) data = data[0] || {};\nif (data.body) {\n  try { data = typeof data.body === 'string' ? JSON.parse(data.body) : data.body; } catch(e) {}\n  if (Array.isArray(data)) data = data[0] || {};\n}\n\nconst response = data.response || data.answer || data.final_response || data.result || data.interpretation || '';\nconst sources = data.sources || [];\n\nreturn [{\n  json: {\n    response: response || 'No response from pipeline',\n    sources: Array.isArray(sources) ? sources.slice(0, 10) : [],\n    pipeline_used: data.engine || data.pipeline_used || 'orchestrator',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
