{
  "name": "Nomos AI — RAG Tests Workers",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" },
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "forwardPorts": [5678],
  "postCreateCommand": "bash /workspaces/${localWorkspaceFolderBasename}/.devcontainer/rag-tests/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "remoteEnv": {
    "N8N_HOST": "https://lbjlincoln-nomos-rag-engine.hf.space",
    "EVAL_MODE": "hf-space",
    "AUTO_EVAL": "true",
    "MAX_QUESTIONS": "1000",
    "REPO_ROLE": "rag-tests"
  }
}
