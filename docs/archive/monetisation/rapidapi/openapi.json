{
  "openapi": "3.0.3",
  "info": {
    "title": "Nomos Multi-RAG API",
    "description": "Production-grade Retrieval-Augmented Generation (RAG) API with three specialized pipelines.\n\n**Standard** -- vector-search RAG over 46K+ documents across 4 industry sectors (Construction, Finance, Legal, Industrial).\n\n**Graph** -- knowledge-graph RAG backed by a Neo4j graph with 86K+ nodes and 76K+ relationships for entity-centric queries.\n\n**Quantitative** -- SQL-generating RAG over 3,800+ financial tables for numerical and analytical queries.\n\nAll pipelines use Llama 3.3 70B for generation with Jina v3 1024-dim embeddings. Responses include source attribution, trace IDs, and engine metadata.",
    "version": "1.0.0",
    "contact": {
      "name": "Nomos AI",
      "email": "alexis.moret6@outlook.fr",
      "url": "https://lbjlincoln.github.io/rag-dashboard/"
    },
    "license": {
      "name": "Proprietary"
    },
    "x-logo": {
      "url": "https://lbjlincoln.github.io/rag-dashboard/favicon.ico"
    }
  },
  "servers": [
    {
      "url": "https://lbjlincoln-nomos-rag-engine.hf.space",
      "description": "Production (Hugging Face Spaces)"
    }
  ],
  "tags": [
    {
      "name": "Standard RAG",
      "description": "Vector-search retrieval-augmented generation over 46K+ indexed documents."
    },
    {
      "name": "Graph RAG",
      "description": "Knowledge-graph traversal RAG using Neo4j with 86K+ nodes."
    },
    {
      "name": "Quantitative RAG",
      "description": "SQL-generating RAG over structured financial tables."
    }
  ],
  "paths": {
    "/webhook/rag-multi-index-v3": {
      "post": {
        "operationId": "queryStandard",
        "summary": "Standard RAG Query",
        "description": "Send a natural-language question to the Standard RAG pipeline. The system retrieves relevant document chunks from a Pinecone vector index (46K+ vectors, Jina v3 embeddings) and generates an answer using Llama 3.3 70B.\n\nBest for: general knowledge questions about construction (BTP), finance, legal, and industrial sectors.",
        "tags": ["Standard RAG"],
        "x-rateLimit": {
          "free": "10 requests/day",
          "basic": "100 requests/day",
          "pro": "1000 requests/day"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StandardRequest"
              },
              "examples": {
                "general": {
                  "summary": "General knowledge question",
                  "value": {
                    "question": "What is the capital of France?"
                  }
                },
                "sector": {
                  "summary": "Sector-specific question",
                  "value": {
                    "question": "What are the main safety regulations in construction?"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response with generated answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                },
                "example": {
                  "response": "The capital of France is Paris.",
                  "trace_id": "tr-1773014118558",
                  "sources": [],
                  "model": "llama-3.3-70b-versatile",
                  "embedding_fallback": true,
                  "engine": "STANDARD",
                  "timestamp": "2026-03-08T23:55:38.458Z"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/webhook/ff622742-6d71-4e91-af71-b5c666088717": {
      "post": {
        "operationId": "queryGraph",
        "summary": "Graph RAG Query",
        "description": "Send a natural-language question to the Graph RAG pipeline. The system traverses a Neo4j knowledge graph (86K+ nodes, 76K+ relationships) to find entity connections and generates an answer using Llama 3.3 70B.\n\nBest for: entity-relationship questions, organizational structure, company networks, and questions requiring multi-hop reasoning across connected data.",
        "tags": ["Graph RAG"],
        "x-rateLimit": {
          "free": "10 requests/day",
          "basic": "100 requests/day",
          "pro": "1000 requests/day"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GraphRequest"
              },
              "examples": {
                "entity": {
                  "summary": "Entity relationship question",
                  "value": {
                    "question": "What companies operate in the construction sector?"
                  }
                },
                "connection": {
                  "summary": "Connection-based question",
                  "value": {
                    "question": "Who are the key people involved in Vinci's operations?"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response with graph-based answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphResponse"
                },
                "example": {
                  "status": "SUCCESS",
                  "trace_id": "tr-graph-1773014200000",
                  "response": "Based on the knowledge graph, several companies operate in the construction sector including Vinci, Bouygues, and Eiffage.",
                  "metadata": {
                    "source": "graph_rag_llm_synthesis",
                    "tokens_used": 450,
                    "traversal_depth": 2,
                    "context_sources": 5,
                    "quality_enhanced": true
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/webhook/3e0f8010-39e0-4bca-9d19-35e5094391a9": {
      "post": {
        "operationId": "queryQuantitative",
        "summary": "Quantitative RAG Query",
        "description": "Send a natural-language question to the Quantitative RAG pipeline. The system translates the question into SQL, executes it against structured financial tables (3,800+ tables in Supabase), and returns both the numerical results and a natural-language interpretation.\n\nBest for: financial metrics, revenue/profit queries, comparative analysis, aggregations, and any question requiring structured data lookups.",
        "tags": ["Quantitative RAG"],
        "x-rateLimit": {
          "free": "10 requests/day",
          "basic": "100 requests/day",
          "pro": "1000 requests/day"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuantRequest"
              },
              "examples": {
                "revenue": {
                  "summary": "Revenue query",
                  "value": {
                    "question": "What is the average revenue in the finance sector?"
                  }
                },
                "comparison": {
                  "summary": "Comparative query",
                  "value": {
                    "question": "Compare net margins of Vinci and Bouygues for 2024"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response with SQL-based answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuantResponse"
                },
                "example": {
                  "status": "SUCCESS",
                  "trace_id": "tr-rag-1773014179282-4glol6f6",
                  "query": "What is the average revenue in the finance sector?",
                  "sql_executed": "SELECT AVG(revenue) FROM financials WHERE sector = 'finance'",
                  "result_count": 1,
                  "interpretation": "The average revenue in the finance sector is 2.3 billion euros based on 45 companies in the database.",
                  "raw_results": [
                    {"avg": 2300000000}
                  ],
                  "null_aggregation": false,
                  "metadata": {
                    "validation_status": "VALID",
                    "timestamp": "2026-03-08T23:56:49.872Z",
                    "engine": "QUANTITATIVE"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StandardRequest": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 3,
            "maxLength": 2000,
            "description": "The natural-language question to answer.",
            "example": "What are the main safety regulations in construction?"
          }
        }
      },
      "GraphRequest": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 3,
            "maxLength": 2000,
            "description": "The natural-language question to answer using the knowledge graph.",
            "example": "What companies operate in the construction sector?"
          }
        }
      },
      "QuantRequest": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 3,
            "maxLength": 2000,
            "description": "The natural-language question to translate into SQL and answer.",
            "example": "What is the average revenue in the finance sector?"
          }
        }
      },
      "StandardResponse": {
        "type": "object",
        "properties": {
          "response": {
            "type": "string",
            "description": "The generated natural-language answer."
          },
          "trace_id": {
            "type": "string",
            "description": "Unique trace identifier for debugging."
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "description": "List of source documents used to generate the answer."
          },
          "model": {
            "type": "string",
            "description": "The LLM model used for generation.",
            "example": "llama-3.3-70b-versatile"
          },
          "embedding_fallback": {
            "type": "boolean",
            "description": "Whether the embedding fallback was used."
          },
          "engine": {
            "type": "string",
            "enum": ["STANDARD"],
            "description": "The pipeline engine that processed this request."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of the response."
          }
        }
      },
      "GraphResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["SUCCESS", "ERROR", "NO_DATA"],
            "description": "Status of the graph query."
          },
          "trace_id": {
            "type": "string",
            "description": "Unique trace identifier for debugging."
          },
          "response": {
            "type": "string",
            "description": "The generated natural-language answer based on graph traversal."
          },
          "metadata": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "description": "Processing source identifier.",
                "example": "graph_rag_llm_synthesis"
              },
              "tokens_used": {
                "type": "integer",
                "description": "Number of LLM tokens consumed."
              },
              "traversal_depth": {
                "type": "integer",
                "description": "Depth of graph traversal performed."
              },
              "context_sources": {
                "type": "integer",
                "description": "Number of graph nodes used as context."
              },
              "quality_enhanced": {
                "type": "boolean",
                "description": "Whether quality enhancement post-processing was applied."
              }
            }
          }
        }
      },
      "QuantResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["SUCCESS", "NULL_RESULT", "ERROR", "SQL_ERROR"],
            "description": "Status of the quantitative query."
          },
          "trace_id": {
            "type": "string",
            "description": "Unique trace identifier for debugging."
          },
          "query": {
            "type": "string",
            "description": "The original natural-language question."
          },
          "sql_executed": {
            "type": "string",
            "description": "The SQL query that was generated and executed."
          },
          "result_count": {
            "type": "integer",
            "description": "Number of rows returned by the SQL query."
          },
          "interpretation": {
            "type": "string",
            "description": "Natural-language interpretation of the SQL results."
          },
          "raw_results": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Raw rows returned by the SQL query."
          },
          "null_aggregation": {
            "type": "boolean",
            "description": "Whether the aggregation returned NULL (no matching data)."
          },
          "metadata": {
            "type": "object",
            "properties": {
              "validation_status": {
                "type": "string",
                "description": "SQL validation result.",
                "example": "VALID"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 timestamp of the response."
              },
              "engine": {
                "type": "string",
                "enum": ["QUANTITATIVE"],
                "description": "The pipeline engine identifier."
              }
            }
          }
        }
      },
      "Source": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Document title."
          },
          "chunk_id": {
            "type": "string",
            "description": "Unique chunk identifier."
          },
          "score": {
            "type": "number",
            "format": "float",
            "description": "Relevance score (0-1)."
          },
          "sector": {
            "type": "string",
            "description": "Industry sector of the source document."
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message."
          },
          "code": {
            "type": "string",
            "description": "Error code."
          },
          "trace_id": {
            "type": "string",
            "description": "Trace ID for debugging."
          }
        }
      }
    },
    "securitySchemes": {
      "RapidAPIKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-RapidAPI-Key",
        "description": "Your RapidAPI application key."
      },
      "RapidAPIHost": {
        "type": "apiKey",
        "in": "header",
        "name": "X-RapidAPI-Host",
        "description": "The RapidAPI host for this API."
      }
    }
  },
  "security": [
    {
      "RapidAPIKey": [],
      "RapidAPIHost": []
    }
  ]
}
