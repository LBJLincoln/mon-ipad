    {
      "parameters": {
        "jsCode": "// Parse action type and extract parameters\nconst body = $input.item.json.body || $input.item.json;\nconst message = body.message || '';\nconst intentData = body.intent || {};\nconst details = intentData.details || {};\n\nlet actionType = 'unknown';\nlet params = {};\n\n// Calendar operations\nif (message.match(/cr\u00e9er.*rendez-vous|ajouter.*calendrier|planifier|rdv/i) || details.action === 'calendar_create') {\n  actionType = 'calendar_create';\n  params = {\n    summary: details.title || 'Rendez-vous',\n    description: details.description || message,\n    start: details.start_time || new Date(Date.now() + 86400000).toISOString(),\n    end: details.end_time || new Date(Date.now() + 90000000).toISOString(),\n    attendees: details.attendees || []\n  };\n}\n// Email send\nelse if (message.match(/envoyer.*email|mail \u00e0|\u00e9crire \u00e0/i) || details.action === 'email_send') {\n  actionType = 'email_send';\n  params = {\n    to: details.recipient || '',\n    subject: details.subject || 'Message automatique',\n    body: details.body || message\n  };\n}\n// Email summary\nelse if (message.match(/r\u00e9sumer.*emails|synth\u00e8se.*messages|derniers mails/i) || details.action === 'email_summary') {\n  actionType = 'email_summary';\n  params = {\n    maxResults: details.max_results || 20,\n    query: details.query || 'is:unread',\n    afterDate: details.after_date || new Date(Date.now() - 7 * 86400000).toISOString()\n  };\n}\n// File search\nelse if (message.match(/chercher.*fichier|trouver.*document|recherche.*drive/i) || details.action === 'file_search') {\n  actionType = 'file_search';\n  params = {\n    query: details.search_query || message.replace(/chercher|trouver|recherche/gi, '').trim()\n  };\n}\n// Unknown action \u2014 send to RAG as fallback\nelse {\n  actionType = 'fallback_rag';\n  params = { query: message };\n}\n\nreturn { actionType, params, originalMessage: message, channel: body.channel, userId: body.user_id };"
      },
