    {
      "parameters": {
        "jsCode": "// Aggregate action results into a structured response\nconst actionType = $('Action Parser').item.json.actionType;\nconst originalMessage = $('Action Parser').item.json.originalMessage;\n\nlet result = { success: true, actionType, originalMessage, answer: '', data: {} };\n\ntry {\n  const input = $input.item.json;\n  switch (actionType) {\n    case 'calendar_create':\n      result.answer = `Rendez-vous cr\u00e9\u00e9: ${input.summary || 'Nouveau RDV'} le ${input.start?.dateTime ? new Date(input.start.dateTime).toLocaleString('fr-FR') : 'date \u00e0 confirmer'}`;\n      result.data = { eventId: input.id, link: input.htmlLink };\n      break;\n    case 'email_send':\n      result.answer = `Email envoy\u00e9 \u00e0 ${input.to || 'destinataire'} \u2014 Sujet: ${input.subject || 'Sans sujet'}`;\n      result.data = { messageId: input.id };\n      break;\n    case 'email_summary':\n      result.answer = input.choices?.[0]?.message?.content || 'R\u00e9sum\u00e9 non disponible';\n      result.data = { emailCount: $items('Gmail Read')?.length || 0 };\n      break;\n    case 'file_search':\n      const files = $input.all();\n      if (files.length === 0) { result.answer = 'Aucun fichier trouv\u00e9.'; }\n      else {\n        result.answer = `${files.length} fichier(s) trouv\u00e9(s):\\n` + files.slice(0, 10).map((f, i) => `${i+1}. ${f.json.name} \u2014 ${f.json.webViewLink}`).join('\\n');\n        result.data = { fileCount: files.length };\n      }\n      break;\n    case 'fallback_rag':\n      result.answer = input.answer || input.response || input.result || 'Pas de r\u00e9sultat';\n      result.data = { sources: input.sources };\n      break;\n    default:\n      result.success = false;\n      result.answer = 'Type d\\'action non reconnu.';\n  }\n} catch (error) {\n  result.success = false;\n  result.answer = `Erreur: ${typeof error === 'object' ? JSON.stringify(error.message || error) : error}`;\n}\n\nreturn result;"
      },
