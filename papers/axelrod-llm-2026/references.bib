@article{lee2026timeseek,
  author  = {Lee, Dennis and Mostafa, Hamza and Shastri, Om},
  title   = {{TimeSeek}: Temporal Reliability of Agentic Forecasters},
  journal = {arXiv preprint},
  year    = {2026},
  url     = {https://arxiv.org/abs/2604.04220},
  note    = {arXiv:2604.04220, April 5 2026. Evaluates 10 frontier LLMs on 150
             CFTC-regulated Kalshi binary markets at 5 temporal checkpoints (15,000
             forecasts total). Key findings: (a) models most competitive early in
             a market's lifecycle and on high-uncertainty events; (b) web search
             improves pooled BSS overall but hurts in 12\% of model-checkpoint pairs;
             (c) two-model ensembles reduce error without surpassing the market.
             Directly relevant to \S4.2 pre-tip-off prediction window design and
             \S7.2 temporal reliability limitation.}
}

