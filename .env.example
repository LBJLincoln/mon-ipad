# Nomos42 .env.example — Canonical template (2026-04-15)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Copy to .env.local and fill in values. NEVER commit .env.local to git.
# Names here are the canonical role-based names. Legacy aliases
# (HF_TOKEN_2, HF_TOKEN_3, NOMOS_NBA_BOT_TOKEN, etc.) are NOT documented
# here — new code should only use the names below.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ─── HuggingFace tokens — 4 accounts, role-based ──────────────────
#   HF_TOKEN          → LBJLincoln      (SDK default, Political islands P1-P8)
#   HF_TOKEN_NBA      → LBJLincoln26    (NBA evolution islands S10-S17, TFs)
#   HF_TOKEN_LLM      → Nomos42         (LLM gateway, pixel world, depts)
#   HF_TOKEN_COUNCILS → TESTforge42     (D1-D8 dept councils + overflow)
export HF_TOKEN=hf_xxx
export HF_TOKEN_NBA=hf_xxx
export HF_TOKEN_LLM=hf_xxx
export HF_TOKEN_COUNCILS=hf_xxx

# ─── Telegram bots — role-based ───────────────────────────────────
#   BOT_TOKEN_NBA     → @Nomos42NBABot       (NBA picks for paying users)
#   BOT_TOKEN_POL     → @Nomos42PoliticalBot (Political Alpha users)
#   BOT_TOKEN_FORGE   → @Forge42Bot          (Forge user login)
#   BOT_TOKEN_RGWA    → @RGWAbot             (art terminal)
#   TELEGRAM_BOT_TOKEN → @Nomos42Bot admin/main channel
